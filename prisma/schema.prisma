generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
  schemas  = ["flow"]
}

model AuthUser {
  id             String                 @id
  name           String
  email          String                 @unique
  emailVerified  Boolean                @map("email_verified")
  emailEnrolled  Boolean                @default(false) @map("email_enrolled")
  mailboxPaused  Boolean                @default(false) @map("mailbox_paused")
  image          String?
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  identities     AuthIdentity[]
  sessions       AuthSession[]
  googleBindings GoogleSubjectBinding[]
  flowUser       FlowUser?
  custodyOperator CustodyOperator?
  recoveryApprovals CustodyRecoveryApproval[]
  issuanceTickets AuthIssuanceTicket[]
  operatorApprovalAssertions OperatorApprovalAssertion[]

  @@map("auth_users")
  @@schema("flow")
}

model GoogleSubjectBinding {
  subject   String   @id
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("google_subject_bindings")
  @@schema("flow")
}

model AuthIdentity {
  id                    String    @id
  userId                String    @map("user_id")
  providerId            String    @map("provider_id")
  accountId             String    @map("provider_subject")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  googleBindingOrder    BigInt    @default(dbgenerated("nextval('flow.google_oauth_order'::regclass)")) @map("google_binding_order")
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([providerId, accountId])
  @@unique([userId, providerId])
  @@map("auth_identities")
  @@schema("flow")
}

model AuthSession {
  id        String   @id
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
  @@schema("flow")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@index([expiresAt])
  @@map("auth_verifications")
  @@schema("flow")
}

model AuthIntent {
  slot             String   @id
  digest           String   @unique
  purpose          String
  email            String?
  userId           String?  @map("user_id")
  sessionId        String?  @map("session_id")
  target           String?
  nonceHash        String?  @map("nonce_hash")
  stateHash        String?  @map("state_hash")
  attempts         Int      @default(0)
  verified         Boolean  @default(false)
  issuedAt         DateTime @map("issued_at")
  expiresAt        DateTime @map("expires_at")
  googleStartOrder BigInt?  @map("google_start_order")

  @@index([expiresAt])
  @@map("auth_intents")
  @@schema("flow")
}

model AuthThrottle {
  key       String   @id
  count     Int
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("auth_throttles")
  @@schema("flow")
}

enum AccountKind {
  PERSONAL
  BUSINESS

  @@map("account_kind")
  @@schema("flow")
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER

  @@map("member_role")
  @@schema("flow")
}

enum MemberStatus {
  ACTIVE
  REMOVED

  @@map("member_status")
  @@schema("flow")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED

  @@map("invite_status")
  @@schema("flow")
}

model FlowUser {
  id              String              @id @default(uuid()) @db.Uuid
  authUserId      String              @unique @map("auth_user_id")
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now()) @map("created_at")
  authUser        AuthUser            @relation(fields: [authUserId], references: [id], onDelete: Restrict)
  personalAccount FlowAccount?
  memberships     AccountMembership[]
  sentInvites     AccountInvite[]
  businessKeys    BusinessCreation[]

  @@map("users")
  @@schema("flow")
}

model FlowAccount {
  id              String                 @id @default(uuid()) @db.Uuid
  kind            AccountKind
  name            String
  personalOwnerId String?                @unique @map("personal_owner_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at")
  personalOwner   FlowUser?              @relation(fields: [personalOwnerId], references: [id], onDelete: Restrict)
  business        BusinessProfile?
  creation        BusinessCreation?
  wallet          FlowWallet?
  provisioningJob WalletProvisioningJob?
  compatibilityAuthorizations ProviderCompatibilityAuthorization[]
  recoveryApprovals CustodyRecoveryApproval[]
  refreshLease    PortfolioRefreshLease?
  activities      WalletActivity[]
  paymentRequests PaymentRequest[]
  ledgerAccounts  LedgerAccount[]

  @@unique([id, kind])
  @@map("accounts")
  @@schema("flow")
}

model BusinessProfile {
  accountId String              @id @map("account_id") @db.Uuid
  kind      AccountKind         @default(BUSINESS)
  account   FlowAccount         @relation(fields: [accountId, kind], references: [id, kind], onDelete: Restrict)
  members   AccountMembership[]
  invites   AccountInvite[]

  @@unique([accountId, kind])
  @@map("business_profiles")
  @@schema("flow")
}

model AccountMembership {
  id        String          @id @default(uuid()) @db.Uuid
  accountId String          @map("account_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  role      MemberRole
  status    MemberStatus    @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at")
  business  BusinessProfile @relation(fields: [accountId], references: [accountId], onDelete: Restrict)
  user      FlowUser        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([accountId, userId])
  @@index([userId, status])
  @@map("account_memberships")
  @@schema("flow")
}

model AccountInvite {
  id        String          @id @default(uuid()) @db.Uuid
  accountId String          @map("account_id") @db.Uuid
  inviterId String          @map("inviter_id") @db.Uuid
  email     String
  role      MemberRole
  digest    String          @unique
  status    InviteStatus    @default(PENDING)
  expiresAt DateTime        @map("expires_at")
  createdAt DateTime        @default(now()) @map("created_at")
  business  BusinessProfile @relation(fields: [accountId], references: [accountId], onDelete: Restrict)
  inviter   FlowUser        @relation(fields: [inviterId], references: [id], onDelete: Restrict)

  @@index([accountId, status])
  @@map("account_invites")
  @@schema("flow")
}

model BusinessCreation {
  actorId     String      @map("actor_id") @db.Uuid
  key         String      @db.Uuid
  fingerprint String
  accountId   String      @unique @map("account_id") @db.Uuid
  actor       FlowUser    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  account     FlowAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([actorId, key])
  @@map("business_creations")
  @@schema("flow")
}

model SecurityAuditEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind        String
  actorAuthId String   @map("actor_auth_id")
  accountId   String?  @map("account_id") @db.Uuid
  targetId    String?  @map("target_id")
  requestId   String   @map("request_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([accountId, createdAt])
  @@map("security_audit_events")
  @@schema("flow")
}

enum WalletStatus {
  SETUP_PENDING
  PROVISIONING
  ACTIVE
  SETUP_FAILED
  FROZEN
  RECOVERY_PENDING

  @@map("wallet_status")
  @@schema("flow")
}

model FlowWallet {
  id                  String             @id @default(uuid()) @db.Uuid
  accountId           String             @unique @map("account_id") @db.Uuid
  provider            String             @default("OUTLAYER")
  environment         String             @default("mainnet")
  providerWalletId    String             @map("provider_wallet_id")
  nearAccountId       String             @map("near_account_id")
  encryptedCredential String             @map("encrypted_credential")
  keyId               String             @default("v1") @map("key_id")
  keyDigest           String             @map("key_digest")
  status              WalletStatus       @default(SETUP_PENDING)
  policyState         String             @default("none") @map("policy_state")
  controllerAccountId String?            @map("controller_account_id")
  handoffUrl          String?            @map("handoff_url")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at")
  account             FlowAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  addresses           WalletAddress[]
  capabilities        WalletCapability[]
  balances            WalletBalance[]
  activities          WalletActivity[]

  @@index([providerWalletId])
  @@map("wallets")
  @@schema("flow")
}

model WalletAddress {
  id        String     @id @default(uuid()) @db.Uuid
  walletId  String     @map("wallet_id") @db.Uuid
  network   String
  chainId   String     @map("chain_id")
  address   String
  publicKey String     @map("public_key")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")
  wallet    FlowWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@unique([walletId, network])
  @@index([network, address])
  @@map("wallet_addresses")
  @@schema("flow")
}

model WalletCapability {
  id                    String     @id @default(uuid()) @db.Uuid
  walletId              String     @map("wallet_id") @db.Uuid
  network               String
  canDeriveAddress      Boolean    @default(true) @map("can_derive_address")
  canReceive            Boolean    @default(true) @map("can_receive")
  canReadNativeBalance  Boolean    @default(false) @map("can_read_native_balance")
  canReadIntentsBalance Boolean    @default(false) @map("can_read_intents_balance")
  canSignTransfer       Boolean    @default(false) @map("can_sign_transfer")
  broadcastMode         String     @default("unsupported") @map("broadcast_mode")
  canRotateCredentials  Boolean    @default(false) @map("can_rotate_credentials")
  verifiedAt            DateTime   @default(now()) @map("verified_at")
  wallet                FlowWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@unique([walletId, network])
  @@map("wallet_capabilities")
  @@schema("flow")
}

model WalletProvisioningJob {
  id                    String      @id @default(uuid()) @db.Uuid
  accountId             String      @unique @map("account_id") @db.Uuid
  idempotencyKey        String      @unique @map("idempotency_key") @db.Uuid
  status                String      @default("PENDING")
  fencingToken          BigInt      @default(0) @map("fencing_token")
  leaseHolder           String?     @map("lease_holder")
  leaseExpiresAt        DateTime?   @map("lease_expires_at")
  dispatchAttemptId     String?     @map("dispatch_attempt_id") @db.Uuid
  dispatchedAt          DateTime?   @map("dispatched_at")
  attempts              Int         @default(0)
  maxAttempts           Int         @default(3) @map("max_attempts")
  failureClassification String?     @map("failure_classification")
  lastError             String?     @map("last_error")
  recoveryEvidence      String?     @map("recovery_evidence")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @default(now()) @updatedAt @map("updated_at")
  account               FlowAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  recoveryApprovals     CustodyRecoveryApproval[]

  @@index([accountId, status])
  @@map("wallet_provisioning_jobs")
  @@schema("flow")
}

model ProviderCompatibilityAuthorization {
  id                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId              String      @map("account_id") @db.Uuid
  environment            String
  singletonScope         String      @unique @default("GLOBAL_TESTNET_REHEARSAL") @map("singleton_scope")
  allowedMethods         String[]    @map("allowed_methods")
  status                 String      @default("AUTHORIZED")
  maxRegistrations       Int         @default(1) @map("max_registrations")
  registrationsAttempted Int         @default(0) @map("registrations_attempted")
  registrationsCompleted Int         @default(0) @map("registrations_completed")
  claimedAt              DateTime?   @map("claimed_at")
  claimedBy              String?     @map("claimed_by")
  consumedAt             DateTime?   @map("consumed_at")
  expiresAt              DateTime    @map("expires_at")
  dispatchAttemptId      String?     @map("dispatch_attempt_id") @db.Uuid
  authorizedByOperatorId String?     @map("authorized_by_operator_id")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @default(now()) @updatedAt @map("updated_at")
  account                FlowAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, status])
  @@map("provider_compatibility_authorizations")
  @@schema("flow")
}

model CustodyOperator {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId String   @unique @map("auth_user_id")
  role       String   @default("CUSTODY_OPERATOR")
  status     String   @default("ACTIVE")
  enrolledBy String   @map("enrolled_by")
  enrolledAt DateTime @default(now()) @map("enrolled_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  user       AuthUser @relation(fields: [authUserId], references: [id], onDelete: Restrict)

  @@map("custody_operators")
  @@schema("flow")
}

model CustodyRecoveryApproval {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId                   String                @map("job_id") @db.Uuid
  accountId               String                @map("account_id") @db.Uuid
  initiatorOperatorAuthId String                @map("initiator_operator_auth_id")
  approverAuthId          String                @map("approver_auth_id")
  resolution              String
  approvalTokenHash       String                @unique @map("approval_token_hash")
  status                  String                @default("PENDING")
  expiresAt               DateTime              @map("expires_at")
  consumedAt              DateTime?             @map("consumed_at")
  dispatchAttemptId       String                @map("dispatch_attempt_id") @db.Uuid
  createdAt               DateTime              @default(now()) @map("created_at")
  job                     WalletProvisioningJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  account                 FlowAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  approver                AuthUser              @relation(fields: [approverAuthId], references: [id], onDelete: Restrict)

  @@index([jobId, status])
  @@map("custody_recovery_approvals")
  @@schema("flow")
}

model FlowAsset {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  symbol        String
  name          String
  kind          String         @default("FUNGIBLE_TOKEN")
  description   String?
  iconUrl       String?        @map("icon_url")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")
  networkAssets NetworkAsset[]
  activities    WalletActivity[]

  @@index([symbol])
  @@map("assets")
  @@schema("flow")
}

model NetworkAsset {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId           String          @map("asset_id") @db.Uuid
  network           String
  chainId           String          @map("chain_id")
  tokenStandard     String          @map("token_standard")
  contractAddress   String?         @map("contract_address")
  decimals          Int
  symbolOverride    String?         @map("symbol_override")
  nameOverride      String?         @map("name_override")
  isVerified        Boolean         @default(true) @map("is_verified")
  isDepositEligible Boolean         @default(false) @map("is_deposit_eligible")
  status            String          @default("ACTIVE")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")
  asset             FlowAsset       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  balances          WalletBalance[]
  activities        WalletActivity[]

  @@index([network, chainId])
  @@index([contractAddress])
  @@map("network_assets")
  @@schema("flow")
}

model WalletBalance {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId            String       @map("wallet_id") @db.Uuid
  networkAssetId      String       @map("network_asset_id") @db.Uuid
  tokenAccountAddress String?      @map("token_account_address")
  atomicBalance       Decimal      @default(0) @map("atomic_balance") @db.Decimal(78, 0)
  blockHeight         BigInt?      @map("block_height")
  blockTimestamp      DateTime?    @map("block_timestamp")
  observedAt          DateTime     @default(now()) @map("observed_at")
  finality            String       @default("UNKNOWN")
  syncStatus          String       @default("NOT_SYNCED") @map("sync_status")
  lastSyncedAt        DateTime?    @map("last_synced_at")
  lastError           String?      @map("last_error")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at")
  wallet              FlowWallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  networkAsset        NetworkAsset @relation(fields: [networkAssetId], references: [id], onDelete: Restrict)

  @@index([walletId, syncStatus])
  @@index([networkAssetId])
  @@map("wallet_balances")
  @@schema("flow")
}

model PortfolioRefreshLease {
  accountId       String      @id @map("account_id") @db.Uuid
  lastRefreshedAt DateTime?   @map("last_refreshed_at")
  leaseExpiresAt  DateTime?   @map("lease_expires_at")
  leaseHolder     String?     @map("lease_holder")
  fencingToken    BigInt      @default(0) @map("fencing_token")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at")
  account         FlowAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("portfolio_refresh_leases")
  @@schema("flow")
}

model AuthIssuanceTicket {
  ticketId   String    @id @default(dbgenerated("gen_random_uuid()")) @map("ticket_id") @db.Uuid
  userId     String    @map("user_id")
  flowType   String    @map("flow_type")
  intentSlot String?   @map("intent_slot")
  createdAt  DateTime  @default(now()) @map("created_at")
  consumedAt DateTime? @map("consumed_at")
  user       AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId, userId])
  @@map("auth_issuance_tickets")
  @@schema("flow")
}

model WalletActivity {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId        String        @map("account_id") @db.Uuid
  walletId         String        @map("wallet_id") @db.Uuid
  network          String
  chainId          String        @map("chain_id")
  ecosystem        String
  activityType     String        @default("ON_CHAIN_TRANSFER") @map("activity_type")
  direction        String
  txHash           String        @map("tx_hash")
  eventIndex       Int           @default(0) @map("event_index")
  fromAddress      String        @map("from_address")
  toAddress        String        @map("to_address")
  assetId          String?       @map("asset_id") @db.Uuid
  networkAssetId   String?       @map("network_asset_id") @db.Uuid
  assetSymbol      String        @map("asset_symbol")
  atomicAmount     Decimal       @default(0) @map("atomic_amount") @db.Decimal(78, 0)
  decimals         Int           @default(18)
  blockHeight      BigInt?       @map("block_height")
  blockHash        String?       @map("block_hash")
  blockTimestamp   DateTime?     @default(now()) @map("block_timestamp")
  finality         String        @default("FINALIZED")
  reorgStatus      String        @default("CANONICAL") @map("reorg_status")
  feeAtomicAmount  Decimal?      @map("fee_atomic_amount") @db.Decimal(78, 0)
  metadata         Json          @default("{}")
  observedAt       DateTime      @default(now()) @map("observed_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at")
  account          FlowAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  wallet           FlowWallet    @relation(fields: [walletId], references: [id], onDelete: Restrict)
  asset            FlowAsset?    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  networkAsset     NetworkAsset? @relation(fields: [networkAssetId], references: [id], onDelete: Restrict)

  @@unique([network, txHash, eventIndex])
  @@index([accountId, blockTimestamp(sort: Desc), id(sort: Desc)])
  @@index([walletId, network])
  @@index([txHash])
  @@map("wallet_activities")
  @@schema("flow")
}

enum PaymentAmountMode {
  FIXED
  OPTIONAL

  @@map("payment_amount_mode")
  @@schema("flow")
}

enum PaymentRequestStatus {
  ACTIVE
  DISABLED
  EXPIRED
  COMPLETED

  @@map("payment_request_status")
  @@schema("flow")
}

model PaymentRequest {
  id                     String               @id @default(uuid()) @db.Uuid
  accountId              String               @map("account_id") @db.Uuid
  publicId               String               @unique @map("public_id") @db.VarChar(64)
  title                  String               @db.VarChar(120)
  description            String?              @db.Text
  destinationNetwork     String               @map("destination_network") @db.VarChar(64)
  destinationAssetId     String               @map("destination_asset_id") @db.VarChar(128)
  destinationAssetSymbol String               @map("destination_asset_symbol") @db.VarChar(32)
  destinationDecimals    Int                  @map("destination_decimals")
  amountMode             PaymentAmountMode    @default(FIXED) @map("amount_mode")
  requestedAtomicAmount  Decimal?             @map("requested_atomic_amount") @db.Decimal(78, 0)
  status                 PaymentRequestStatus @default(ACTIVE)
  expiresAt              DateTime?            @map("expires_at") @db.Timestamptz
  payerMemoRequired      Boolean              @default(false) @map("payer_memo_required")
  metadata               Json                 @default("{}") @db.JsonB
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  account                FlowAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  attempts               PaymentAttempt[]
  rehearsalAuthorizations PaymentRehearsalAuthorization[]
  operatorApprovalAssertions OperatorApprovalAssertion[]

  @@index([accountId, status])
  @@index([publicId])
  @@map("payment_requests")
  @@schema("flow")
}

model PaymentAttempt {
  id                            String         @id @default(uuid()) @db.Uuid
  paymentRequestId              String         @map("payment_request_id") @db.Uuid
  attemptPublicId               String         @unique @map("attempt_public_id") @db.VarChar(64)
  payerMode                     String         @map("payer_mode") @db.VarChar(32)
  payerRefundAddress            String?        @map("payer_refund_address") @db.VarChar(128)
  sourceNetwork                 String         @map("source_network") @db.VarChar(64)
  sourceAssetId                 String         @map("source_asset_id") @db.VarChar(128)
  sourceAssetSymbol             String         @map("source_asset_symbol") @db.VarChar(32)
  sourceDecimals                Int            @map("source_decimals")
  routeType                     String         @map("route_type") @db.VarChar(32)
  routeStatus                   String         @map("route_status") @db.VarChar(32)
  swapType                      String         @default("EXACT_OUTPUT") @map("swap_type") @db.VarChar(32)
  quotedSourceAtomicAmount      Decimal?       @map("quoted_source_atomic_amount") @db.Decimal(78, 0)
  quotedDestinationAtomicAmount Decimal?       @map("quoted_destination_atomic_amount") @db.Decimal(78, 0)
  estimatedDurationSeconds      Int?           @map("estimated_duration_seconds")
  providerFees                  Json           @default("{}") @map("provider_fees") @db.JsonB
  providerCorrelationId         String?        @map("provider_correlation_id") @db.VarChar(128)
  providerSignature             String?        @map("provider_signature") @db.Text
  quoteExpiresAt                DateTime?      @map("quote_expires_at") @db.Timestamptz
  status                        String         @default("QUOTE_OBSERVED") @db.VarChar(32)
  verificationTier              String         @default("UNVERIFIED_OBSERVATION") @map("verification_tier") @db.VarChar(32)
  isProviderVerified            Boolean        @default(false) @map("is_provider_verified")
  depositAddress                String?        @map("deposit_address") @db.VarChar(256)
  depositMemo                   String?        @map("deposit_memo") @db.VarChar(128)
  depositDeadline               DateTime?      @map("deposit_deadline") @db.Timestamptz
  depositInstructions           Json           @default("{}") @map("deposit_instructions") @db.JsonB
  sourceTxHash                  String?        @map("source_tx_hash") @db.VarChar(128)
  destinationTxHash             String?        @map("destination_tx_hash") @db.VarChar(128)
  settlementError               String?        @map("settlement_error") @db.Text
  settledAt                     DateTime?      @map("settled_at") @db.Timestamptz
  monitoringLeaseWorkerId       String?        @map("monitoring_lease_worker_id") @db.VarChar(64)
  monitoringLeaseExpiresAt      DateTime?      @map("monitoring_lease_expires_at") @db.Timestamptz
  lastPolledAt                  DateTime?      @map("last_polled_at") @db.Timestamptz
  pollCount                     Int            @default(0) @map("poll_count")
  exceptionStatus               String?        @default("NONE") @map("exception_status") @db.VarChar(32)
  refundAtomicAmount            Decimal?       @map("refund_atomic_amount") @db.Decimal(78, 0)
  createdAt                     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  paymentRequest                PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  verifications                 PaymentVerification[]
  rehearsalAuthorizations       PaymentRehearsalAuthorization[]

  @@index([paymentRequestId, createdAt(sort: Desc)])
  @@index([attemptPublicId])
  @@index([paymentRequestId, status])
  @@index([status])
  @@map("payment_attempts")
  @@schema("flow")
}

model PaymentVerification {
  id               String         @id @default(uuid()) @db.Uuid
  paymentAttemptId String         @map("payment_attempt_id") @db.Uuid
  verificationType String         @map("verification_type") @db.VarChar(32)
  network          String         @db.VarChar(64)
  txHash           String         @map("tx_hash") @db.VarChar(128)
  eventIndex       Int            @default(0) @map("event_index")
  fromAddress      String         @map("from_address") @db.VarChar(256)
  toAddress        String         @map("to_address") @db.VarChar(256)
  assetId          String         @map("asset_id") @db.VarChar(128)
  tokenContract    String?        @map("token_contract") @db.VarChar(256)
  atomicAmount     Decimal        @map("atomic_amount") @db.Decimal(78, 0)
  blockHeight      BigInt?        @map("block_height")
  blockHash        String?        @map("block_hash") @db.VarChar(128)
  finality         String         @db.VarChar(32)
  memo             String?        @db.VarChar(128)
  evidenceSource   String         @map("evidence_source") @db.VarChar(32)
  rawEvidence      Json           @default("{}") @map("raw_evidence") @db.JsonB
  verifiedAt       DateTime       @default(now()) @map("verified_at") @db.Timestamptz
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz

  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  @@unique([network, txHash, eventIndex, verificationType])
  @@index([paymentAttemptId, verificationType])
  @@map("payment_verifications")
  @@schema("flow")
}

model LedgerAccount {
  id            String        @id @default(uuid()) @db.Uuid
  accountId     String?       @map("account_id") @db.Uuid
  accountType   String        @map("account_type") @db.VarChar(32)
  accountCode   String        @map("account_code") @db.VarChar(64)
  assetId       String        @map("asset_id") @db.VarChar(128)
  network       String        @db.VarChar(64)
  decimals      Int
  balanceAtomic Decimal       @default(0) @map("balance_atomic") @db.Decimal(78, 0)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  account       FlowAccount?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entries       LedgerEntry[]

  @@index([accountId])
  @@map("ledger_accounts")
  @@schema("flow")
}

model LedgerJournal {
  id              String        @id @default(uuid()) @db.Uuid
  journalPublicId String        @unique @map("journal_public_id") @db.VarChar(64)
  referenceType   String        @map("reference_type") @db.VarChar(32)
  referenceId     String        @map("reference_id") @db.VarChar(128)
  description     String        @db.Text
  status          String        @default("POSTED") @db.VarChar(32)
  postedAt        DateTime      @default(now()) @map("posted_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  entries         LedgerEntry[]

  @@index([referenceType, referenceId])
  @@index([postedAt(sort: Desc)])
  @@map("ledger_journals")
  @@schema("flow")
}

model LedgerEntry {
  id              String        @id @default(uuid()) @db.Uuid
  journalId       String        @map("journal_id") @db.Uuid
  ledgerAccountId String        @map("ledger_account_id") @db.Uuid
  entryDirection  String        @map("entry_direction") @db.VarChar(16)
  amountAtomic    Decimal       @map("amount_atomic") @db.Decimal(78, 0)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  journal         LedgerJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@index([journalId])
  @@index([ledgerAccountId])
  @@map("ledger_entries")
  @@schema("flow")
}

model PaymentRehearsalAuthorization {
  id                         String         @id @default(uuid()) @db.Uuid
  paymentRequestId           String         @map("payment_request_id") @db.Uuid
  operatorAuthId             String         @map("operator_auth_id") @db.VarChar(128)
  environment                String         @default("mainnet") @db.VarChar(32)
  sourceNetwork              String         @map("source_network") @db.VarChar(64)
  sourceAssetId              String         @map("source_asset_id") @db.VarChar(128)
  destinationNetwork         String         @map("destination_network") @db.VarChar(64)
  destinationAssetId         String         @map("destination_asset_id") @db.VarChar(128)
  maxAtomicAmount            Decimal        @map("max_atomic_amount") @db.Decimal(78, 0)
  allowedPayerRefundAddress  String?        @map("allowed_payer_refund_address") @db.VarChar(128)
  allowedRecipientAddress    String         @map("allowed_recipient_address") @db.VarChar(128)
  expiresAt                  DateTime       @map("expires_at") @db.Timestamptz
  consumedAt                 DateTime?      @map("consumed_at") @db.Timestamptz
  consumedByAttemptId        String?        @map("consumed_by_attempt_id") @db.Uuid
  assertionId                String?        @map("assertion_id") @db.Uuid
  createdAt                  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  paymentRequest             PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  consumedByAttempt          PaymentAttempt? @relation(fields: [consumedByAttemptId], references: [id], onDelete: SetNull)
  operatorAssertion          OperatorApprovalAssertion? @relation(fields: [assertionId], references: [id], onDelete: SetNull)

  @@index([paymentRequestId, environment, expiresAt])
  @@map("payment_rehearsal_authorizations")
  @@schema("flow")
}

model OperatorApprovalAssertion {
  id                         String         @id @default(uuid()) @db.Uuid
  assertionTokenHash         String         @unique @map("assertion_token_hash") @db.VarChar(128)
  operatorAuthId             String         @map("operator_auth_id") @db.VarChar(128)
  paymentRequestId           String         @map("payment_request_id") @db.Uuid
  environment                String         @default("mainnet") @db.VarChar(32)
  sourceNetwork              String         @map("source_network") @db.VarChar(64)
  sourceAssetId              String         @map("source_asset_id") @db.VarChar(128)
  destinationNetwork         String         @map("destination_network") @db.VarChar(64)
  destinationAssetId         String         @map("destination_asset_id") @db.VarChar(128)
  maxAtomicAmount            Decimal        @map("max_atomic_amount") @db.Decimal(78, 0)
  allowedRecipientAddress    String         @map("allowed_recipient_address") @db.VarChar(128)
  allowedPayerRefundAddress  String?        @map("allowed_payer_refund_address") @db.VarChar(128)
  nonce                      String         @unique @db.VarChar(128)
  signature                  String?
  expiresAt                  DateTime       @map("expires_at") @db.Timestamptz
  consumedAt                 DateTime?      @map("consumed_at") @db.Timestamptz
  consumedByAuthorizationId  String?        @map("consumed_by_authorization_id") @db.Uuid
  createdAt                  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  paymentRequest             PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  user                       AuthUser       @relation(fields: [operatorAuthId], references: [id], onDelete: Restrict)
  authorizations             PaymentRehearsalAuthorization[]

  @@index([paymentRequestId, operatorAuthId, expiresAt])
  @@map("operator_approval_assertions")
  @@schema("flow")
}


