# FLOW Staging Environment Variable Template
# For the Render Web Service runtime environment.
# All values must be supplied securely via the platform secret manager.
# Never commit real credentials to Git.

FLOW_ENV=staging
FLOW_EXECUTION=disabled

# Direct Neon PostgreSQL endpoint for runtime (must target flow_staging as flow_staging_app with sslmode=verify-full)
FLOW_DATABASE_URL=postgresql://flow_staging_app:replace-with-staging-app-password@ep-example-123456.us-east-2.aws.neon.tech:5432/flow_staging?sslmode=verify-full

# Canonical HTTPS Origin (e.g. Render default hostname or custom subdomain)
FLOW_APP_ORIGIN=https://flow-staging.onrender.com

# Independent 32-byte hex keys (generate each separately with `openssl rand -hex 32`)
FLOW_AUTH_SECRET=replace-with-a-random-64-character-hex-key
FLOW_OTP_KEY=replace-with-a-different-random-64-character-hex-key

# Dedicated Google OAuth 2.0 Web Client credentials
FLOW_GOOGLE_CLIENT_ID=replace-with-staging-client-id.apps.googleusercontent.com
FLOW_GOOGLE_CLIENT_SECRET=replace-with-staging-google-client-secret

# Resend API Key and verified domain sender
FLOW_MAIL_API_KEY=re_replace_with_staging_mail_key
FLOW_MAIL_FROM=auth@mail.example.com

# Node version for Render
NODE_VERSION=24.22.2

# -----------------------------------------------------------------------------
# MIGRATION ONLY (Run by operator in an isolated process; DO NOT set in Web Service)
# FLOW_MIGRATION_DATABASE_URL=postgresql://flow_staging_migrator:replace-with-staging-migrator-password@ep-example-123456.us-east-2.aws.neon.tech:5432/flow_staging?sslmode=require&sslaccept=strict

