# ==============================================================================
# FLOW Local Integration & Worker Environment Variable Template
# ==============================================================================
# This template documents all variables required to run FLOW locally with real
# blockchain RPCs, PostgreSQL, authentication, and the wallet provisioning worker.
#
# INSTRUCTIONS:
# 1. Copy this file to `.env` for local development.
# 2. Generate separate 32-byte (64-hex) keys using:
#      openssl rand -hex 32
# 3. Never commit `.env` or any real credentials to Git or share them in chat.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE ENVIRONMENT & SAFETY GUARDS
# ------------------------------------------------------------------------------
# Target environment: 'local', 'test', 'staging', or 'production'
FLOW_ENV=local

# Financial safety kill-switch: MUST remain strictly 'disabled'.
# Unconditionally blocks all customer fund movements, payments, signing and transfers.
FLOW_EXECUTION=disabled

# ------------------------------------------------------------------------------
# 2. RUNTIME DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Must target the flow_local database as flow_local_app (runtime role).
# The app role has least-privilege permissions (no schema alterations, no audit deletion).
FLOW_DATABASE_URL=postgresql://flow_local_app:replace-with-local-app-password@127.0.0.1:55432/flow_local

# ------------------------------------------------------------------------------
# 3. WEB RUNTIME AUTHENTICATION & SESSIONS
# ------------------------------------------------------------------------------
# Canonical origin where the local Next.js server is reached.
FLOW_APP_ORIGIN=http://127.0.0.1:3000

# Server-side authentication secrets (each must be a distinct 64-character hex key).
# Generate each separately: openssl rand -hex 32
FLOW_AUTH_SECRET=replace-with-a-random-64-character-hex-key
FLOW_OTP_KEY=replace-with-a-different-random-64-character-hex-key

# Dedicated Google OAuth 2.0 Web Client credentials (for Google Sign-In)
FLOW_GOOGLE_CLIENT_ID=replace-with-development-client-id.apps.googleusercontent.com
FLOW_GOOGLE_CLIENT_SECRET=replace-with-development-google-client-secret

# Resend transactional email API credentials (for OTP emails)
FLOW_MAIL_API_KEY=re_replace_with_development_mail_key
FLOW_MAIL_FROM=auth@example.test

# ------------------------------------------------------------------------------
# 4. DEDICATED WALLET PROVISIONING WORKER & ENVELOPE ENCRYPTION
# ------------------------------------------------------------------------------
# Wallet custody provider: 'outlayer' (default) or 'mock' (for offline testing)
FLOW_WALLET_PROVIDER=outlayer

# Master AES-256-GCM envelope encryption key for wallet credentials (32-byte hex).
# MUST be completely distinct from FLOW_AUTH_SECRET and FLOW_OTP_KEY!
# In production (Railway/Vercel), this variable is provisioned ONLY to the worker.
FLOW_WALLET_ENCRYPTION_KEY=replace-with-a-third-random-64-character-hex-key

# Key identifier for versioned envelope rotation (default 'v1')
FLOW_WALLET_KEY_ID=v1

# OutLayer Coordinator API base URL
# Production: https://api.outlayer.ai
# Local testing: loopback mock server
FLOW_OUTLAYER_API_URL=https://api.outlayer.ai

# ------------------------------------------------------------------------------
# 5. READ-ONLY BLOCKCHAIN JSON-RPC ENDPOINTS (Zero credentials or gas needed)
# ------------------------------------------------------------------------------
# NEAR Public JSON-RPC endpoint
FLOW_NEAR_RPC_URL=https://rpc.mainnet.near.org

# Base (EVM) Public JSON-RPC endpoint
FLOW_BASE_RPC_URL=https://mainnet.base.org

# Solana Public JSON-RPC endpoint
FLOW_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ------------------------------------------------------------------------------
# 6. FUTURE NEAR INTENTS 1CLICK INTEGRATION (M5 / M6 Preview)
# ------------------------------------------------------------------------------
# 1Click market maker quote and swap API endpoint
FLOW_NEAR_INTENTS_API_URL=https://1click.chaindefuser.com

# ------------------------------------------------------------------------------
# 7. FAIL-CLOSED PROVIDER COMPATIBILITY MODE (Controlled Rehearsal Only)
# ------------------------------------------------------------------------------
# Live OutLayer calls are strictly blocked while FLOW_EXECUTION=disabled unless this
# compatibility mode is explicitly authorized by the project owner.
# Default: disabled
FLOW_PROVIDER_COMPATIBILITY_MODE=disabled

# Database-enforced single-use authorization record UUID (created via job repository)
# FLOW_PROVIDER_COMPATIBILITY_AUTHORIZATION_ID=00000000-0000-0000-0000-000000000000

# Target provider environment: 'testnet' (recommended for rehearsal) or 'mainnet'
FLOW_PROVIDER_COMPATIBILITY_ENVIRONMENT=testnet

# High-entropy authorization token required when compatibility mode is enabled
# FLOW_PROVIDER_COMPATIBILITY_TOKEN=replace-with-authorized-rehearsal-token

# Isolated developer account UUID permitted for the single test registration
# FLOW_PROVIDER_COMPATIBILITY_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# Strict hard cap on live registrations (must be 1)
FLOW_PROVIDER_COMPATIBILITY_MAX_REGISTRATIONS=1

# ------------------------------------------------------------------------------
# 8. MIGRATION DATABASE CREDENTIAL (Operator-Only Process)
# ------------------------------------------------------------------------------
# DO NOT include in web runtime or worker environment. Use ONLY when running
# `npm run db:deploy` or Prisma migration scripts from an operator terminal.
# FLOW_MIGRATION_DATABASE_URL=postgresql://flow_local_migrator:replace-with-local-migrator-password@127.0.0.1:55432/flow_local
