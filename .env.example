# ==============================================================================
# FLOW Environment Variable Reference Template (.env.example)
# ==============================================================================
# This template catalogs all environment variables recognized by the FLOW platform.
#
# SECURITY & PROCESS ISOLATION RULES:
# 1. Never commit real credentials or .env files to source control.
# 2. Web Runtime (Vercel / Railway Web):
#    - MUST only receive FLOW_DATABASE_URL (flow_app role).
#    - MUST NEVER receive FLOW_WALLET_ENCRYPTION_KEY, FLOW_OPERATOR_DATABASE_URL,
#      or FLOW_MIGRATION_DATABASE_URL.
# 3. Worker Runtime (Railway Worker / Procfile worker):
#    - MUST receive FLOW_WORKER_DATABASE_URL (flow_worker role).
#    - MUST receive FLOW_WALLET_ENCRYPTION_KEY for envelope encryption.
#    - MUST NEVER receive FLOW_OPERATOR_DATABASE_URL or FLOW_MIGRATION_DATABASE_URL.
# 4. Operator Terminal / CI Deploy:
#    - Supply FLOW_MIGRATION_DATABASE_URL only during migration runs (npm run db:deploy).
#    - Supply FLOW_OPERATOR_DATABASE_URL only for authorized administrative operations.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & SAFETY GUARDS
# ------------------------------------------------------------------------------
# Target environment: 'local', 'test', 'staging', or 'production'
FLOW_ENV=local

# Financial safety killswitch: MUST remain strictly 'disabled'.
# Unconditionally blocks all customer fund movements, payments, signing, and transfers.
FLOW_EXECUTION=disabled

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CREDENTIALS (ROLE & PROCESS SEGREGATED)
# ------------------------------------------------------------------------------
# Web Runtime App Role: Used by Next.js web application.
# Local: postgresql://flow_local_app:password@127.0.0.1:55432/flow_local
# Staging/Prod: postgresql://flow_<env>_app:password@host:5432/flow_<env>?sslmode=verify-full
FLOW_DATABASE_URL=postgresql://flow_local_app:replace-with-local-app-password@127.0.0.1:55432/flow_local

# Background Worker Role: Used exclusively by the background worker.
# Local: postgresql://flow_local_worker:password@127.0.0.1:55432/flow_local
# Staging/Prod: postgresql://flow_<env>_worker:password@host:5432/flow_<env>?sslmode=verify-full
# FLOW_WORKER_DATABASE_URL=postgresql://flow_local_worker:replace-with-local-worker-password@127.0.0.1:55432/flow_local

# Operator Role: Used exclusively for operator scripts and security procedures.
# FLOW_OPERATOR_DATABASE_URL=postgresql://flow_local_operator:replace-with-local-operator-password@127.0.0.1:55432/flow_local

# Migration Role: Used exclusively by Prisma CLI during schema deployments.
# Prohibited from web and worker runtime processes.
# FLOW_MIGRATION_DATABASE_URL=postgresql://flow_local_migrator:replace-with-local-migrator-password@127.0.0.1:55432/flow_local

# ------------------------------------------------------------------------------
# 3. WEB RUNTIME AUTHENTICATION & SESSIONS
# ------------------------------------------------------------------------------
# Canonical HTTPS/HTTP Origin of the application.
FLOW_APP_ORIGIN=http://127.0.0.1:3000

# High-entropy 32-byte hex keys (generate each with: openssl rand -hex 32)
# FLOW_AUTH_SECRET and FLOW_OTP_KEY must be distinct from each other and all other keys.
FLOW_AUTH_SECRET=replace-with-a-random-64-character-hex-key
FLOW_OTP_KEY=replace-with-a-different-random-64-character-hex-key

# Dedicated Google OAuth 2.0 Web Client credentials (for Google Sign-In)
FLOW_GOOGLE_CLIENT_ID=replace-with-development-client-id.apps.googleusercontent.com
FLOW_GOOGLE_CLIENT_SECRET=replace-with-development-google-client-secret

# Resend transactional email API credentials (for Email OTP delivery)
FLOW_MAIL_API_KEY=re_replace_with_development_mail_key
FLOW_MAIL_FROM=auth@example.test

# Optional trusted reverse-proxy client IP header ('x-real-ip' or 'cf-connecting-ip')
# FLOW_CLIENT_IP_HEADER=cf-connecting-ip

# ------------------------------------------------------------------------------
# 4. CUSTODY & OUTLAYER INTEGRATION (WORKER RUNTIME ONLY)
# ------------------------------------------------------------------------------
# Wallet custody provider: 'outlayer' (default) or 'mock' (for offline testing)
# FLOW_WALLET_PROVIDER=outlayer

# Master AES-256-GCM envelope encryption key (32-byte hex key).
# MUST be isolated to worker process. NEVER set in Web Runtime or commit to Git.
# FLOW_WALLET_ENCRYPTION_KEY=replace-with-a-third-random-64-character-hex-key

# Key version identifier for envelope rotation (default: 'v1')
# FLOW_WALLET_KEY_ID=v1

# OutLayer Coordinator API URL:
# Production: https://api.outlayer.ai
# Testnet:    https://testnet-api.outlayer.ai
# FLOW_OUTLAYER_API_URL=https://api.outlayer.ai

# ------------------------------------------------------------------------------
# 5. READ-ONLY BLOCKCHAIN JSON-RPC ENDPOINTS (OPTIONAL / CANONICAL FALLBACKS)
# ------------------------------------------------------------------------------
# Optional custom public or private RPC endpoints (used for verification & activity)
# FLOW_BASE_RPC_URL=https://mainnet.base.org
# FLOW_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# FLOW_NEAR_RPC_URL=https://rpc.mainnet.near.org
# FLOW_ETH_RPC_URL=https://rpc.ankr.com/eth

# ------------------------------------------------------------------------------
# 6. 1CLICK SWAP & DEFUSE PROTOCOL (OPTIONAL)
# ------------------------------------------------------------------------------
# 1Click market maker quote and swap API endpoint
# FLOW_NEAR_INTENTS_API_URL=https://1click.chaindefuser.com

# Optional partner credentials (only required if participating in Defuse fee-sharing)
# FLOW_ONE_CLICK_API_KEY=replace-with-defuse-partner-api-key
# FLOW_ONE_CLICK_PARTNER_ID=replace-with-defuse-partner-id

# ------------------------------------------------------------------------------
# 7. OPERATOR PRIVILEGE & SESSION ATTESTATION (OPERATOR CLI ONLY)
# ------------------------------------------------------------------------------
# Enrolled operator identity identifier
# FLOW_CUSTODY_OPERATOR_AUTH_ID=operator-owner-primary

# High-entropy operator session token or path to signed session assertion file
# FLOW_CUSTODY_OPERATOR_SESSION_TOKEN=replace-with-operator-session-token
# FLOW_CUSTODY_OPERATOR_SESSION_FILE=/path/to/operator-session.json

# Optional dedicated HMAC secret for operator assertion signing
# FLOW_OPERATOR_TRUSTED_EXECUTION_KEY=replace-with-trusted-operator-hmac-key

# ------------------------------------------------------------------------------
# 8. BACKGROUND PAYMENT MONITORING WORKER CONFIGURATION
# ------------------------------------------------------------------------------
# Optional runner configuration overrides
# FLOW_MONITORING_WORKER_ID=flow-worker-instance-1
# FLOW_MONITORING_POLL_INTERVAL_MS=5000
# FLOW_MONITORING_BATCH_SIZE=10
# FLOW_MONITORING_LEASE_SECONDS=30

# ------------------------------------------------------------------------------
# 9. PROVIDER COMPATIBILITY REHEARSAL GUARDS (TESTNET ONLY)
# ------------------------------------------------------------------------------
# Fail-closed rehearsal gates; MUST remain 'disabled' in normal operation.
# FLOW_PROVIDER_COMPATIBILITY_MODE=disabled
# FLOW_PROVIDER_COMPATIBILITY_AUTHORIZATION_ID=00000000-0000-0000-0000-000000000000
# FLOW_PROVIDER_COMPATIBILITY_ENVIRONMENT=testnet
# FLOW_PROVIDER_COMPATIBILITY_TOKEN=replace-with-rehearsal-token
# FLOW_PROVIDER_COMPATIBILITY_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
# FLOW_PROVIDER_COMPATIBILITY_MAX_REGISTRATIONS=1
