{
  "name": "flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.2",
    "npm": "11.19.1"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "predev": "npm run db:generate",
    "build": "next build --webpack",
    "prebuild": "npm run db:generate",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "pretypecheck": "npm run db:generate",
    "test": "node --test \"test/*.test.ts\"",
    "test:db": "node --test test/database.integration.ts",
    "test:security": "node --test test/security.integration.mjs",
    "db:generate": "prisma generate --config prisma.generate.config.ts",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:check": "node --env-file-if-exists=.env scripts/check-database.ts",
    "check:integration": "node --env-file-if-exists=.env scripts/check-integration.ts",
    "check:outlayer": "node --env-file-if-exists=.env scripts/check-outlayer-connectivity.ts",
    "activate:mainnet-wallet": "node --env-file-if-exists=.env scripts/activate-first-mainnet-wallet.ts",
    "authorize:testnet": "node --env-file-if-exists=.env scripts/rehearse-testnet-registration.ts --create-authorization",
    "rehearse:testnet": "node --env-file-if-exists=.env scripts/rehearse-testnet-registration.ts",
    "prepare:testnet-account": "node --env-file-if-exists=.env scripts/prepare-testnet-account.ts",
    "check:balances": "node --env-file-if-exists=.env scripts/check-balances.ts",
    "worker:monitoring": "node --env-file-if-exists=.env scripts/run-payment-monitoring-worker.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.18",
    "@defuse-protocol/one-click-sdk-typescript": "0.1.26",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.18",
    "jose": "6.2.15",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.5",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "1.65.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  },
  "overrides": {
    "minimatch@^10": "11.0.4"
  }
}
